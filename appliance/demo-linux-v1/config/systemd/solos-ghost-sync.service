[Unit]
Description=Sync minimized SolOS Ghost evidence to the private CMS monitor
After=solos-daemon.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/solos-ghost-sync.env
Environment=SOLOS_DAEMON_SOCKET=%t/solos/daemon.sock
ExecStart=/opt/solos-runtime/tools/sync-ghost-brain.mjs

[Install]
WantedBy=default.target
