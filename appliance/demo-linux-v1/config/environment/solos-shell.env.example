# Copy to /etc/solos-shell.env or /opt/solos-shell/.env if needed
SOLOS_BIND_HOST=127.0.0.1
SOLOS_PORT=8080
SOLOS_ROOT=/opt/solos-shell/current
SOLOS_LOG_LEVEL=info

# Independent Ghost API (never embed an API key in an ISO or source file).
# Remote SolOS: forward this localhost port over SSH, or use your HTTPS endpoint.
SOLOS_GHOST_API_URL=http://127.0.0.1:18791/v1
SOLOS_GHOST_API_KEY_FILE=/home/solos/.config/ghost/api.key
